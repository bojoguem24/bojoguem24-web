# 클라이언트 사이드 (브라우저에서 직접 호출)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 사이트 URL (OG tags, sitemap, canonical 등에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 서버 사이드 전용 (Docker 내부 통신 — NEXT_PUBLIC 변수보다 우선 사용됨)
# API_URL=http://api:8000

# 네이버 서치어드바이저 인증 코드 (설정하지 않으면 메타태그 미출력)
# NAVER_SITE_VERIFICATION=여기에_인증코드_입력
